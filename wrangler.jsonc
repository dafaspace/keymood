// keymood.app: a Cloudflare Worker that serves only static files, no script.
// Deployed from the terminal with `npx wrangler deploy`, from a clean export of the
// release tag (DEV.md, release ritual). The same repo still feeds GitHub Pages,
// whose copy hands saved settings over to keymood.app (index.html).
{
  "name": "keymood",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./"
  },
  "routes": [
    { "pattern": "keymood.app", "custom_domain": true }
  ]
}
